# Copia este archivo como .env y ajusta los valores.
PORT=4321
HOST=127.0.0.1
# Dirección pública de la web (se usa en enlaces, QR y en el Redirect URI de Spotify).
# Spotify solo acepta https:// o http://127.0.0.1 (no "localhost").
PUBLIC_URL=http://127.0.0.1:4321
# Pon TRUST_PROXY=1 si la web está detrás de un proxy inverso (Nginx, Render, Railway…).
TRUST_PROXY=0
# Opcional: contraseña inicial del panel (si no, se crea desde /admin la primera vez).
GUSPIRA_ADMIN_PASSWORD=
# Opcional: credenciales de la app de Spotify (también se pueden poner desde el panel).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Carpeta de datos (eventos, peticiones, presupuestos).
GUSPIRA_DATA_DIR=./data
